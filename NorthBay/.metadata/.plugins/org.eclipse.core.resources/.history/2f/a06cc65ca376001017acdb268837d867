	public void scrollToElement(WebElement element,WebDriver driver) throws InterruptedException {
		JavascriptExecutor js=(JavascriptExecutor)driver;
		waitForHardWait(2000);
		((JavascriptExecutor) driver).executeScript("arguments[0].scrollIntoView(true);", element);
		js.executeScript("arguments[0].style.border='3px solid red'", element);
		waitForHardWait(2000);
	}
	
	public void scrollToMultipleElements(WebDriver driver) throws InterruptedException {
		
		List<WebElement> elements=driver.findElements(By.xpath("//h2"));
		
		for(int i=0;i<elements.size();i++) {
			
			scrollToElement(elements.get(i),driver);
		}
	}
	
	 /**
     * Checks for broken HTML tags in the current page loaded by the given WebDriver.
     *
     * @param driver The Selenium WebDriver instance pointing to the loaded page.
     */
	public static void checkBrokenLinksAndImages(WebDriver driver) {
        int brokenCount = 0;

        // Find all <a> and <img> elements
        List<WebElement> elements = driver.findElements(By.xpath("//a[@href] | //img[@src]"));
        for (WebElement element : elements) {
            String tag = element.getTagName();
            String url = tag.equalsIgnoreCase("a") ? element.getAttribute("href") : element.getAttribute("src");

            if (url == null || url.trim().isEmpty()) {
                System.out.println("Skipped empty URL in <" + tag + ">");
                continue;
            }

            try {
                HttpURLConnection connection = (HttpURLConnection) new URL(url).openConnection();
                connection.setRequestMethod("HEAD");
                connection.setConnectTimeout(5000);
                connection.connect();

                int statusCode = connection.getResponseCode();
                if (statusCode >= 400) {
                    System.out.println("Broken " + tag + " - " + url + " | Status Code: " + statusCode);
                    brokenCount++;
                } else {
                    System.out.println("Valid " + tag + " - " + url);
                }
            } catch (IOException e) {
                System.out.println("Error checking " + tag + " - " + url + " | Exception: " + e.getMessage());
                brokenCount++;
            }
        }

        Assert.assertTrue(brokenCount==0,"borken links found");
    }
	
	
